# --- Finance Operations Portal configuration -------------------------------
# Copy to .env and edit. Never commit the real .env.

# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg2://finops:CHANGE_ME@localhost:5432/finops

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Set to 1 when the site is served over HTTPS (recommended in production)
SESSION_HTTPS_ONLY=0

# Where uploaded Tally exports are archived on the server
UPLOAD_DIR=./var/uploads

# Optional existing client-controlled MIRRORED Google Drive folder for daily backups.
# It is never used as a shared/live database or automatic restore source.
# Keep the live database on the local PC, never in a synced folder.
# BACKUP_DIR=C:\\Users\\Client\\My Drive\\GST8020 Backups

# First administrator, created on first start only
BOOTSTRAP_ADMIN_EMAIL=admin@oswalgroup.net
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisOnFirstLogin
